          "powerpoint"
        ],
        "limits": {
          "wallTimeMs": 900000,
          "modelCalls": 32,
          "inputTokens": 3000000,
          "canvasCalls": 10,
          "failedToolCalls": 1,
          "failedToolRate": 0.02
        },
        "requiredQaChecks": {
          "powerpoint": [
            "opens",
            "packageValid",
            "editable",
            "exactlyThreeActiveSlides",
