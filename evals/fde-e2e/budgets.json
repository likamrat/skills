          "trial-1",
          "trial-2",
          "trial-3",
          "trial-4",
          "trial-5"
        ]
      }
    },
    "readout-pptx-smoke": {
        "description": "Temporary replay-only budget for the three-slide native PowerPoint smoke gate.",
