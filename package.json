{
  "name": "likamrat-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Skills that describe how specific work should be carried out with AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/likamrat/skills.git"
  },
  "homepage": "https://skills.sh/likamrat/skills",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "ai-at-work",
    "role-specific-ai",
    "forward-deployed-engineering",
    "fde",
    "customer-engineering",
    "ai"
  ],
  "skills": [
    "./skills/fde/fde-engagement",
    "./skills/fde/fde-readout"
  ],
  "scripts": {
    "check": "node scripts/check-em-dashes.mjs && node scripts/check-acronyms.mjs && node scripts/validate-skills.mjs && node scripts/check-links.mjs --local && node scripts/test-fde-evaluator.mjs",
    "check:cli": "node --no-deprecation scripts/test-cli-commands.mjs",
    "check:fde:e2e": "node scripts/test-fde-evaluator.mjs",
    "check:links": "node scripts/check-links.mjs --external",
    "eval:fde:e2e": "node scripts/evaluate-fde-run.mjs",
    "eval:triggers": "node scripts/evaluate-triggering.mjs",
    "list:skills": "npx skills@1.5.22 add . --list",
    "score:skills": "node scripts/score-skills.mjs"
  },
  "packageManager": "npm@11.17.0"
}
